[Unit]
Description=Daily local SQLite snapshot and restored-data verification

[Service]
Type=oneshot
User=internship-watch
Group=internship-watch
WorkingDirectory=/opt/internship-watch
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/internship-watch/.venv/bin/python /opt/internship-watch/deploy/backup.py --config /etc/internship-watch.json --state-dir /var/lib/internship-watch/local-backups --local-only
TimeoutStartSec=30min
UMask=0077
ReadWritePaths=/var/lib/internship-watch
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Nice=15
IOSchedulingClass=idle
