# Protected host file: /etc/internship-watch-backup.env (root:root, mode 0600).
# Use Backblaze B2's S3 endpoint from the bucket settings, not this placeholder.
RESTIC_REPOSITORY=s3:https://s3.REGION.backblazeb2.com/BUCKET/internship-watch
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD_FILE=/etc/internship-watch-restic-password
RESTIC_CACHE_DIR=/var/lib/internship-watch/restic-cache
# Separate Healthchecks check: period 24 hours, grace 2 hours, email integration.
BACKUP_HEALTHCHECKS_PING_URL=
