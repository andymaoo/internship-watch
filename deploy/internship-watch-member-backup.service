[Unit]
Description=Verify a daily local SQLite recovery copy of the member feed

[Service]
Type=oneshot
User=internship-watch
Group=internship-watch
WorkingDirectory=/opt/internship-watch-member
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/internship-watch-member/.venv/bin/python /opt/internship-watch-member/deploy/backup.py --config /etc/internship-watch-member.json --state-dir /var/lib/internship-watch-member/local-backups --local-only
TimeoutStartSec=10min
UMask=0077
ReadWritePaths=/var/lib/internship-watch-member
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Nice=15
IOSchedulingClass=idle
