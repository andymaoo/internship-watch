# Fill in a host-side secret file or hosting secret settings. Never commit values.
# Discord: incoming webhook URLs obtained from your chosen Discord channels.
DISCORD_WEBHOOK_URL=
OPS_DISCORD_WEBHOOK_URL=
# Independent Healthchecks.io check. Treat its entire ping URL as a secret.
HEALTHCHECKS_PING_URL=
# Separate daily-backup check; email destinations are configured in Healthchecks.
BACKUP_HEALTHCHECKS_PING_URL=
# For off-host backup credentials, see deploy/backup.env.example.
# Optional existing ntfy integration. Set notifications.channel to ntfy to use it.
NTFY_URL=
NTFY_TOKEN=
OPS_NTFY_URL=
OPS_NTFY_TOKEN=
